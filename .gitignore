# Allow-list: this folder also holds raw survey data, DB dumps and county
# exports (some with respondent PII). Only the dashboard code is tracked.
*
!/.gitignore
!/.gitattributes
!/.dockerignore
!/.env.example
!/Dockerfile
!/docker-compose.yml
!/requirements.txt
!/README.md
!/dashboard.py
!/dashboard.html
!/team.html
!/build_qc.py
!/export_qc.py
!/target_counties.txt
!/deploy/
!/deploy/restore_db.sh
!/deploy/add_digitiser.sh
!/deploy/update.sh
!/deploy/make_team_credentials.py
!/deploy/init_https.sh
!/deploy/init_selfsigned.sh
!/deploy/nginx/
!/deploy/nginx/dashboard.conf.template
!/deploy/sql/
!/deploy/sql/*.sql

# never, even if un-ignored above by mistake
.env
qgis_access.txt
*.dump
credentials/
deploy/nginx/.htpasswd
*.jsonl
__pycache__/
