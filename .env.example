# Copy to `.env` in the same folder and fill in real values. Never commit `.env`.

# --- docker compose (server) ---------------------------------------------
POSTGRES_PASSWORD=change_me        # superuser password for the postgis container
# PG_HOST_PORT=5432                # host port for Postgres (QGIS etc.)
# DASH_HOST_PORT=5055              # host port for the dashboard

# Public HTTPS via nginx (`docker compose --profile public`)
# NGINX_HTTPS_PORT=8443            # host ports for nginx (80/443 are used by other systems)
# NGINX_HTTP_PORT=8088
# DOMAIN=41.x.x.x                  # public IP -> deploy/init_selfsigned.sh
# DOMAIN=coffee.example.com        # real domain -> deploy/init_https.sh
# LETSENCRYPT_EMAIL=you@example.com

# Signs the /team portal login cookie (any long random string)
DASH_SECRET=

# Basemap keys (served to the browser via /api/config)
CARTO_KEY=
MAPTILER_KEY=

# --- running dashboard.py / build_qc.py directly (local dev) --------------
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change_me
PGDATABASE=coffee_eudr

# --- kobo_fetch.py only ---------------------------------------------------
KOBO_TOKEN=your_api_token_here
KOBO_ASSET_UID=your_form_id_here
KOBO_BASE_URL=https://kf.kobotoolbox.org
